# Generate unique secrets. Never commit .env or real credentials.
POSTGRES_PASSWORD=replace-with-local-migration-password
MIGRATION_DATABASE_URL=postgresql://postgres:replace-with-local-migration-password@localhost:5432/cargoorbit
RUNTIME_DATABASE_PASSWORD=replace-with-runtime-password-32-characters
DATABASE_URL=postgresql://cargoorbit_runtime:replace-with-runtime-password-32-characters@localhost:5432/cargoorbit
JWT_SECRET=replace-with-random-secret-at-least-32-characters
OTP_SECRET=replace-with-different-random-secret-32-characters
# 32 random bytes encoded as 64 hex characters; required for privileged production MFA.
MFA_ENCRYPTION_KEY=
SEED_PASSWORD=replace-with-local-demo-password
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/v1
EVIDENCE_STORAGE=local
EVIDENCE_ROOT=../../var/evidence
MALWARE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Production: NODE_ENV=production; private versioned S3; HTTPS; real SMS adapter.
AWS_REGION=ap-south-1
S3_BUCKET=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_CALLBACK_SECRET=
INVITATION_WEBHOOK_URL=
INVITATION_WEBHOOK_TOKEN=
# Explicit trusted reverse proxy addresses/CIDRs only; leave blank for direct development.
TRUST_PROXY_CIDRS=
# Operator-approved provider configuration; default means no enabled external operations.
INTEGRATION_CONFIG_JSON=[]
EXPORT_MAX_BYTES=5368709120
EXPORT_MAX_SECONDS=1800
EXPORT_MAX_MEMBERS=100000
