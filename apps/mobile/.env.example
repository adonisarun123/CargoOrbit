# Android emulator local development only. A physical device needs the reachable HTTPS API URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/v1
CARGOORBIT_ALLOW_DEV_HTTP=true
# Local preview / production: configure EXPO_PUBLIC_API_URL as an HTTPS URL in the build environment.
# No provider credentials belong in an EXPO_PUBLIC_* variable; these values are embedded in the app.
